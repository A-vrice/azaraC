; azaraC を使う PlatformIO プロジェクトの設定例
; プロジェクトルートに platformio.ini としてコピーして使う
; azaraC は C++17 必須のため -std=gnu++17 を指定する

[env:uno]
platform = atmelavr@5.3.0
board = uno
framework = arduino
lib_deps = A-vrice/azaraC@^1.0.0
build_unflags = -std=gnu++11
build_flags = -std=gnu++17

[env:esp32dev]
platform = espressif32@7.0.1
board = esp32dev
framework = arduino
lib_deps = A-vrice/azaraC@^1.0.0
build_unflags = -std=gnu++11
build_flags = -std=gnu++17
