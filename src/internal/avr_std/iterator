#pragma once
// azaraC - src/internal/avr_std/iterator
// Minimal <iterator> shim for the Arduino AVR toolchain (no libstdc++).
// Provides std::size only (used by the manual a3 provider table).

#include <stddef.h>

#if defined(AZARAC_AVR_STUB)
#include <iterator>
#else
namespace std {

template <typename T, std::size_t N>
constexpr std::size_t size(const T (&)[N]) noexcept {
    return N;
}

}  // namespace std
#endif
