#pragma once
// azaraC - src/internal/avr_std/cstdio
// Minimal <cstdio> shim for the Arduino AVR toolchain (no libstdc++).
// avr-libc provides <stdio.h> (vsnprintf/snprintf available).

#if defined(AZARAC_AVR_STUB)
#include <cstdio>
#else
#include <stdio.h>
// avr-libc exposes snprintf in the global namespace; re-export it as
// std::snprintf so host and AVR builds call the same qualified name.
namespace std {
using ::snprintf;
}
#endif
