#pragma once
// azaraC - src/internal/avr_std/utility
// Minimal <utility> shim for the Arduino AVR toolchain (no libstdc++).
// Provides std::move / std::forward only (all azaraC uses).

#if defined(AZARAC_AVR_STUB)
#include <utility>
#else
namespace std {

template <typename T>
constexpr T&& move(T& t) noexcept {
    return static_cast<T&&>(t);
}

template <typename T>
constexpr T&& forward(T& t) noexcept {
    return static_cast<T&&>(t);
}

template <typename T>
constexpr T&& forward(T&& t) noexcept {
    return static_cast<T&&>(t);
}

}  // namespace std
#endif
